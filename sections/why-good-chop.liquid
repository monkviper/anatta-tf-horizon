<div class="color-{{ section.settings.color_scheme }} why-good-chop-wrapper{% if section.settings.section_width == 'page-width' %} section--page-width{% endif %}"
  style="
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="why-good-chop">
    <div class="why-good-chop__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="why-good-chop__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="why-good-chop__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="why-good-chop__points">
        {%- for block in section.blocks -%}
          <div class="why-good-chop__point" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="why-good-chop__point-image">
                {{
                  block.settings.image
                  | image_url: height: 96
                  | image_tag:
                    loading: 'lazy',
                    widths: '48, 96',
                    class: 'why-good-chop__point-icon'
                }}
              </div>
            {%- endif -%}
            <div class="why-good-chop__point-content">
              {%- if block.settings.heading != blank -%}
                <h3 class="why-good-chop__point-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="why-good-chop__point-description">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .why-good-chop-wrapper {
    padding-block-start: var(--section-padding-top);
    padding-block-end: var(--section-padding-bottom);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .why-good-chop-wrapper.section--page-width {
    padding-inline: max(2rem, 50% - var(--page-width) / 2);
  }

  .why-good-chop {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .why-good-chop__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .why-good-chop__heading {
    font-family: var(--font-heading--family);
    font-size: 24px;
    line-height: 32px;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-foreground-heading, var(--color-foreground));
    margin: 0;
  }

  .why-good-chop__description {
    display: none;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: var(--color-foreground);
    margin: 0;
  }

  .why-good-chop__points {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .why-good-chop__point {
    display: flex;
    flex-direction: row;
    gap: 16px;
    align-items: flex-start;
  }

  .why-good-chop__point-image {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .why-good-chop__point-icon {
    height: 48px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .why-good-chop__point-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .why-good-chop__point-heading {
    font-family: var(--font-subheading--family, var(--font-body--family));
    font-size: 18px;
    line-height: 28px;
    font-weight: 700;
    color: var(--color-foreground-heading, var(--color-foreground));
    margin: 0;
  }

  .why-good-chop__point-description {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .why-good-chop {
      gap: 40px;
      align-items: center;
    }

    .why-good-chop__header {
      align-items: center;
    }

    .why-good-chop__heading {
      font-size: 32px;
      line-height: 40px;
      text-align: center;
    }

    .why-good-chop__description {
      display: block;
      text-align: center;
    }

    .why-good-chop__points {
      flex-direction: row;
      gap: 32px;
      width: 100%;
    }

    .why-good-chop__point {
      flex: 1;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
    }

    .why-good-chop__point-image {
      width: auto;
      height: 48px;
    }

    .why-good-chop__point-content {
      gap: 0;
    }

    .why-good-chop__point-heading {
      text-align: center;
    }

    .why-good-chop__point-description {
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.why_good_chop",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHY GOOD CHOP?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "In the past three years, meat and seafood prices in U.S. have gone up significantly. Our base plan prices have stayed the same since 2021."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:names.why_good_chop",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "heading": "Outstanding Value",
            "description": "Inflation-resistant pricing, members-only savings, and more."
          }
        },
        {
          "type": "point",
          "settings": {
            "heading": "100% American",
            "description": "Proteins sourced from independent American farms and fisheries."
          }
        },
        {
          "type": "point",
          "settings": {
            "heading": "Convenient Deliveries",
            "description": "Flexible, fully customizable deliveries every 4, 6, or 8 weeks."
          }
        },
        {
          "type": "point",
          "settings": {
            "heading": "Money-back Guarantee",
            "description": "No commitments—skip, reschedule, or cancel anytime."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
