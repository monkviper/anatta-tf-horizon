{% comment %}
  Custom Fonts — Anton

  Loads the Anton font via Google Fonts and overrides the heading/accent
  CSS custom properties set by theme-styles-variables.liquid.

  Note: The font_picker settings (type_heading_font, type_accent_font) show
  "Source Sans Pro" in the Shopify theme editor because Anton is not in
  Shopify's font library. The actual rendered font is Anton via this CSS
  override. If Google Fonts is unreachable, headings will gracefully
  fall back to sans-serif.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">

<style>
  :root {
    --font-heading--family: 'Anton', sans-serif;
    --font-accent--family: 'Anton', sans-serif;
  }
</style>
