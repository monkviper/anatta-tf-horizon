                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-heading--family)",
                "font_size": "18px",
                "line_height": "28px",
                "letter_spacing": "normal",
                "case": "none",
